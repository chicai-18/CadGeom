@PACKAGE_INIT@

# CadGeom package config.
#
#   find_package(CadGeom REQUIRED)
#   target_link_libraries(my_app PRIVATE CadGeom::cadgeom)
#
# That is the whole integration: the imported target carries the include
# directory and the import library, and cadgeom.dll ships next to it in bin/.
# The engine has no public dependencies to propagate — Vulkan, GLFW and the
# rest are private implementation details linked inside the DLL.

include("${CMAKE_CURRENT_LIST_DIR}/CadGeomTargets.cmake")

check_required_components(CadGeom)

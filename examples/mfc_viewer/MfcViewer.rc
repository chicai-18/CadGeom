//
// IDR_MAINFRAME 那条是 CFrameWnd::LoadFrame 拿去做窗口标题的。状态栏的窗格
// id 也要有字符串：CStatusBar::SetIndicators 用它量窗格的初始宽度。

STRINGTABLE
BEGIN
    IDR_MAINFRAME           "CadGeom — MFC 宿主示例"
    ID_INDICATOR_PROMPT     "就绪"
    ID_INDICATOR_SELECTION  "选中 0 / 0"
    ID_INDICATOR_MEASURE    "测量 —"
    ID_INDICATOR_DEVICE     "设备"
END
